{
  "name": "driver-manager-napi-rs",
  "version": "0.0.1",
  "description": "Experimental napi-rs bindings for the Rust ADBC driver manager",
  "private": true,
  "author": "Apache Arrow Developers",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "native"
  ],
  "scripts": {
    "build": "npm run build:native && npm run build:ts",
    "build:native": "cargo build --manifest-path ./native/Cargo.toml --release --target-dir ./native/target && node ./scripts/copy-native.js release",
    "build:native:debug": "cargo build --manifest-path ./native/Cargo.toml --target-dir ./native/target && node ./scripts/copy-native.js debug",
    "build:ts": "tsc --project tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "apache-arrow": "^21.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "apache-arrow": "^21.1.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.5"
  }
}

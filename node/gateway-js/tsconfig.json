{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "declaration": true,
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": "..", // Relative to node/ (workspace root)
    "paths": {
      "adbc-node": ["native/dist"] // Path to adbc-node's dist/ relative to baseUrl
    }
  },
  "include": ["src"]
}

  "components": {
    "schemas": {
      "CreateConnectionRequest": {
        "type": "object",
        "properties": {
          "options": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "example": "{\"adbc.connection.autocommit\": \"false\"}"
          }
        }
      },
      "CreateConnectionResponse": {
        "type": "object",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string"
          }
        }
      },
      "CreateDatabaseRequest": {
        "type": "object",
        "required": [
          "driver"
        ],
        "properties": {
          "driver": {
            "type": "string",
            "example": "{\"uri\": \":memory:\"}"
          },
          "name": {
            "type": "string",
            "example": "my_database",
            "nullable": true
          },
          "options": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "CreateDatabaseResponse": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          }
        }
      },
      "CreateStatementResponse": {
        "type": "object",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string"
          }
        }
      },
      "DatabaseInfo": {
        "type": "object",
        "required": [
          "id",
          "driver_name"
        ],
        "properties": {
          "driver_name": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "QueryRequest": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string"
          }
        }
      },
      "Scope": {
        "type": "string",
        "enum": [
          "Connection",
          "Statement"
        ]
      },
      "SetOptionRequest": {
        "type": "object",
        "required": [
          "key",
          "value"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      },
      "SetSqlQueryRequest": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "bearer_auth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "quiver",
      "description": "ADBC Gateway API"
    }
  ]
}
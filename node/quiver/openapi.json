{
  "openapi": "3.0.3",
  "info": {
    "title": "quiver",
    "description": "",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/databases": {
      "get": {
        "tags": [
          "crate"
        ],
        "operationId": "list_databases",
        "responses": {
          "200": {
            "description": "List active databases",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DatabaseInfo"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "crate"
        ],
        "operationId": "create_database",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDatabaseRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Database created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateDatabaseResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/databases/{id}": {
      "delete": {
        "tags": [
          "crate"
        ],
        "operationId": "delete_database",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Database ID to delete",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Database deleted"
          },
          "404": {
            "description": "Database not found"
          }
        }
      }
    },
    "/drivers": {
      "get": {
        "tags": [
          "crate"
        ],
        "operationId": "list_drivers",
        "responses": {
          "200": {
            "description": "List available drivers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "crate"
        ],
        "operationId": "health_check",
        "responses": {
          "200": {
            "description": "Health check passed",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateDatabaseRequest": {
        "type": "object",
        "required": [
          "driver"
        ],
        "properties": {
          "driver": {
            "type": "string",
            "example": "sqlite"
          },
          "options": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "example": "{\"uri\": \":memory:\"}"
          }
        }
      },
      "CreateDatabaseResponse": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          }
        }
      },
      "DatabaseInfo": {
        "type": "object",
        "required": [
          "id",
          "driver_name"
        ],
        "properties": {
          "driver_name": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "quiver",
      "description": "ADBC Gateway API"
    }
  ]
}
{
  "compilerOptions": {
    "target": "ES2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM"],
    "baseUrl": "..",
    "paths": {
      "apache-arrow": ["./node_modules/apache-arrow"],
      "adbc-shared": ["shared"]
    }
  },
  "include": ["src"]
}
